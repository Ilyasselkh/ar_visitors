<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ar_visitor_checkout_wizard_form" model="ir.ui.view">
        <field name="name">ar.visitor.checkout.wizard.form</field>
        <field name="model">ar.visitor.checkout.wizard</field>
        <field name="arch" type="xml">
            <form string="Signature de sortie">
                <group>
                    <field name="visit_id"/>
                    <field name="visitor_name"/>
                </group>
                <group string="Le visiteur doit signer avant la validation de sa sortie">
                    <field name="signature" widget="signature" nolabel="1"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Valider la sortie" class="btn-primary"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
