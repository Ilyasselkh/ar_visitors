<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_ar_visitor_checkout_wizard_form" model="ir.ui.view">
        <field name="name">ar.visitor.checkout.wizard.form</field>
        <field name="model">ar.visitor.checkout.wizard</field>
        <field name="arch" type="xml">
            <form string="Signature de sortie" class="ar_checkout_form">
                <field name="language" invisible="1"/>
                <sheet>
                    <div class="ar_checkout_hero">
                        <span class="ar_checkout_icon"><i class="fa fa-sign-out" aria-hidden="true"/></span>
                        <div><span class="ar_checkout_eyebrow">SORTIE VISITEUR</span><h2>Finalisez votre sortie</h2><p>Veuillez signer ci-dessous pour confirmer votre sortie.</p></div>
                        </div>
                    <div class="ar_checkout_details">
                        <div><span>RÉFÉRENCE DE VISITE</span><field name="visit_id" readonly="1" nolabel="1"/></div>
                        <div><span>VISITEUR</span><field name="visitor_name" readonly="1" nolabel="1"/></div>
                    </div>
                    <div class="ar_checkout_signature_section">
                        <div class="ar_checkout_section_heading"><div><span class="ar_checkout_eyebrow">SIGNATURE REQUISE</span><h3>Signez dans la zone ci-dessous</h3></div><i class="fa fa-pencil-square-o" aria-hidden="true"/></div>
                        <field name="signature" widget="ar_signature_pad" nolabel="1"/>
                    </div>
                </sheet>
                <footer>
                    <button name="action_confirm" type="object" string="Enregistrer ma signature" class="btn-primary"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                    </footer>
            </form>
        </field>
    </record>
</odoo>
