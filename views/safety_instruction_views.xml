<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_safety_instruction_list" model="ir.ui.view">
        <field name="name">ar.visitor.safety.instruction.list</field>
        <field name="model">ar.visitor.safety.instruction</field>
        <field name="arch" type="xml"><list editable="bottom" open_form_view="1" class="ar_visitor_admin"><field name="sequence" widget="handle"/><field name="emoji"/><field name="name"/><field name="active"/></list></field>
    </record>
    <record id="view_safety_instruction_form" model="ir.ui.view">
        <field name="name">ar.visitor.safety.instruction.form</field>
        <field name="model">ar.visitor.safety.instruction</field>
        <field name="arch" type="xml">
            <form class="ar_visitor_admin"><sheet>
                <group><field name="sequence"/><field name="active"/><field name="emoji"/><field name="name"/></group>
                <notebook><page string="Images par langue">
                    <field name="image_ids">
                        <list editable="bottom" open_form_view="1" class="ar_visitor_admin">
                            <field name="sequence" widget="handle"/>
                            <field name="image" widget="image" options="{'size': [80, 80]}"/>
                            <field name="name"/><field name="language"/><field name="active"/>
                        </list>
                        <form string="Image de sécurité" class="ar_visitor_admin"><sheet>
                            <group><field name="name"/><field name="language"/><field name="sequence"/><field name="active"/></group>
                            <field name="filename" invisible="1"/>
                            <field name="image" widget="image" filename="filename" options="{'size': [600, 600]}"/>
                        </sheet></form>
                    </field>
                </page></notebook>
            </sheet></form>
        </field>
    </record>
    <record id="action_safety_instruction" model="ir.actions.act_window"><field name="name">Consignes de sécurité</field><field name="res_model">ar.visitor.safety.instruction</field><field name="view_mode">list,form</field></record>
</odoo>
