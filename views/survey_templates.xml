<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <template id="visitor_survey_safety_intro" inherit_id="survey.survey_fill_form_start">
        <xpath expr="//div[@t-field='survey.description']" position="after">
            <t t-set="visitor_safety" t-value="answer._visitor_safety_instructions()"/>
            <section t-if="visitor_safety" class="ar_survey_safety">
                <h2><i class="fa fa-shield" aria-hidden="true"/> <t t-out="{'fr': 'Consignes de sécurité', 'en': 'Safety instructions', 'es': 'Instrucciones de seguridad', 'ar': 'تعليمات السلامة'}[answer._visitor_safety_language()]"/></h2>
                <article t-foreach="visitor_safety" t-as="instruction">
                    <div class="ar_survey_safety_content">
                        <span class="ar_survey_safety_emoji" t-out="instruction['emoji']"/>
                        <p t-out="instruction['name']"/>
                    </div>
                    <div t-if="instruction['images']" class="ar_survey_safety_images">
                        <img t-foreach="instruction['images']" t-as="image" t-att-src="image['url']" t-att-alt="image['name']" loading="lazy"/>
                    </div>
                </article>
            </section>
        </xpath>
    </template>

    <template id="visitor_survey_done" inherit_id="survey.survey_fill_form_done">

        <xpath expr="//div[hasclass('o_survey_finished')]" position="inside">

            <t t-set="visitor_url" t-value="answer._visitor_return_url()"/>

            <t t-if="visitor_url">

                <a class="btn btn-primary" data-visitor-return="1" t-att-href="visitor_url" t-out="answer._visitor_continue_label()"/>

                <script>if (window.parent !== window) {

                    window.parent.postMessage('ar-visitors-quiz-completed', window.location.origin);

                } else {

                    window.location.replace(document.querySelector("a[data-visitor-return]").href);

                }</script>

            </t>

        </xpath>

    </template>

</odoo>

