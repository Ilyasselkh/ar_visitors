<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ar_visitor_visit_search" model="ir.ui.view">
        <field name="name">ar.visitor.visit.search</field><field name="model">ar.visitor.visit</field>
        <field name="arch" type="xml"><search>
            <field name="name"/><field name="cin"/><field name="person_id" groups="ar_visitors.group_ar_visitors_api_admin"/><field name="host_employee_id"/>
            <filter name="present" string="Présents" domain="[('state','=','checked_in')]"/>
            <filter name="waiting" string="En attente" domain="[('state','in',['draft','identity_input','identity_check','quiz_pending','host_pending','signature_pending','approval_pending'])]"/>
            <filter name="today" string="Aujourd'hui" domain="[('check_in_at','&gt;=',context_today().strftime('%Y-%m-%d'))]"/>
            <group><filter name="group_state" string="État" context="{'group_by':'state'}"/><filter name="group_host" string="Personne visitée" context="{'group_by':'host_employee_id'}"/><filter name="group_day" string="Jour" context="{'group_by':'check_in_at:day'}"/></group>
        </search></field>
    </record>
    <record id="view_ar_visitor_visit_list" model="ir.ui.view">
        <field name="name">ar.visitor.visit.list</field><field name="model">ar.visitor.visit</field>
        <field name="arch" type="xml"><list decoration-success="state == 'checked_in'" decoration-muted="state in ('checked_out','cancelled')" decoration-danger="state == 'refused'">
            <field name="name"/><field name="check_in_at"/><field name="person_id" groups="ar_visitors.group_ar_visitors_api_admin"/><field name="first_name"/><field name="last_name"/><field name="cin"/>
            <field name="host_employee_id"/><field name="department_id" optional="hide"/><field name="check_out_at"/><field name="duration_hours" widget="float_time"/><field name="notification_state" widget="badge"/><field name="state" widget="badge"/>
        </list></field>
    </record>
    <record id="view_ar_visitor_visit_form" model="ir.ui.view">
        <field name="name">ar.visitor.visit.form</field><field name="model">ar.visitor.visit</field>
        <field name="arch" type="xml"><form string="Visite" class="ar_visit_form">
            <header>
                <button name="action_open_kiosk" type="object" string="Ouvrir le parcours visiteur" class="btn-primary" invisible="state not in ('draft','identity_input','identity_check','quiz_pending','host_pending')"/>
                <button name="action_start_manual" type="object" string="Démarrer le parcours" class="btn-primary" invisible="state != 'draft'"/>
                <button name="action_confirm_identity" type="object" string="Valider l'identité" class="btn-primary" invisible="state != 'identity_input'"/>
                <button name="action_select_language" type="object" string="Charger le quiz" class="btn-primary" invisible="state != 'identity_check'"/>
                <button name="action_open_quiz" type="object" string="Ouvrir le quiz" class="btn-primary" invisible="state != 'quiz_pending'"/>
                <button name="action_check_quiz" type="object" string="Vérifier le quiz" class="btn-success" invisible="state != 'quiz_pending'"/>
                <button name="action_check_in" type="object" string="Enregistrer et notifier" class="btn-success" invisible="state != 'host_pending'"/>
                <button name="action_check_out" type="object" string="Enregistrer la sortie" class="btn-primary" invisible="state not in ('checked_in','signature_pending')"/>
                <button name="action_approve" type="object" string="Valider le contrôle" groups="ar_visitors.group_ar_visitors_user" invisible="state != 'approval_pending'"/>
                <button name="action_refuse" type="object" string="Refuser" groups="ar_visitors.group_ar_visitors_user" invisible="state in ('checked_in','checked_out','refused','cancelled')"/>
                <button name="action_cancel" type="object" string="Annuler" invisible="state in ('checked_in','checked_out','refused','cancelled')"/>
                <field name="state" widget="statusbar" statusbar_visible="draft,identity_input,identity_check,quiz_pending,host_pending,checked_in,checked_out"/>
            </header>
            <sheet>
                <div class="ar_visit_hero">
                    <field name="photo" widget="image" class="ar_visit_photo" options="{'size': [112, 112]}"/>
                    <div class="ar_visit_heading">
                        <span class="ar_visit_eyebrow">FICHE VISITEUR</span>
                        <h1><field name="name" readonly="1"/></h1>
                        <div class="ar_visit_subtitle">Accueil et suivi de la visite</div>
                    </div>
                </div>
                <div class="ar_visit_cards">
                    <div class="ar_visit_card">
                        <h3>Identité du visiteur</h3>
                        <group>
                            <field name="person_id" groups="ar_visitors.group_ar_visitors_api_admin"/>
                            <field name="first_name"/>
                            <field name="last_name"/>
                            <field name="cin" required="state != 'draft'"/>
                            <field name="nationality_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="visitor_company"/>
                        </group>
                    </div>
                    <div class="ar_visit_card">
                        <h3>Détails de la visite</h3>
                        <group>
                            <field name="host_employee_id" options="{'no_create': True}"/>
                            <field name="department_id"/>
                            <field name="purpose"/>
                            <field name="entry_signature" widget="signature" readonly="state != 'host_pending'"/>
                            <field name="entry_signature_at" invisible="not entry_signature_at"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </div>
                </div>
                <div class="ar_visit_times">
                    <div><label for="check_in_at"/><field name="check_in_at"/></div>
                    <div><label for="check_out_at"/><field name="check_out_at"/></div>
                    <div><label for="duration_hours"/><field name="duration_hours" widget="float_time"/></div>
                </div>
                <notebook>
                    <page string="Quiz"><group><group><field name="language"/></group><group><field name="survey_id"/><field name="survey_user_input_id"/><field name="quiz_completed"/><field name="quiz_score" groups="ar_visitors.group_ar_visitors_manager"/><field name="quiz_completed_at"/></group></group></page>
                    <page string="Signature du visiteur">
                        <field name="entry_signature" widget="image" readonly="1"/>
                        <field name="entry_signature_at" readonly="1"/>
                        <group string="Ancienne signature de sortie" invisible="not signature">
                            <field name="signature" widget="image" readonly="1"/><field name="signature_at" readonly="1"/>
                        </group>
                    </page>
                </notebook>
                <chatter/>
            </sheet>
        </form></field>
    </record>
    <record id="action_ar_visitor_present" model="ir.actions.act_window"><field name="name">Visiteurs présents</field><field name="res_model">ar.visitor.visit</field><field name="view_mode">list,form</field><field name="domain">[('state','=','checked_in')]</field></record>
    <record id="action_ar_visitor_waiting" model="ir.actions.act_window"><field name="name">Visites en attente</field><field name="res_model">ar.visitor.visit</field><field name="view_mode">list,form</field><field name="domain">[('state','in',['draft','identity_input','identity_check','quiz_pending','host_pending','signature_pending','approval_pending'])]</field></record>
    <record id="action_ar_visitor_completed" model="ir.actions.act_window"><field name="name">Visiteurs sortis</field><field name="res_model">ar.visitor.visit</field><field name="view_mode">list,form</field><field name="domain">[('state','=','checked_out')]</field></record>
    <record id="action_ar_visitor_analysis" model="ir.actions.act_window"><field name="name">Analyse des visites</field><field name="res_model">ar.visitor.visit</field><field name="view_mode">pivot,graph,list</field></record>
    <record id="action_ar_visitor_refused" model="ir.actions.act_window"><field name="name">Visites refusées</field><field name="res_model">ar.visitor.visit</field><field name="view_mode">list,form</field><field name="domain">[('state','=','refused')]</field></record>
    <record id="action_ar_visitor_cancelled" model="ir.actions.act_window"><field name="name">Visites annulées</field><field name="res_model">ar.visitor.visit</field><field name="view_mode">list,form</field><field name="domain">[('state','=','cancelled')]</field></record>
</odoo>
