<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <template id="kiosk_page" name="AR Visitors - Borne">

        <html>

            <head>

                <meta charset="utf-8"/>

                <meta name="viewport" content="width=device-width, initial-scale=1"/>

                <title>AR - Visitors</title>

                <t t-call-assets="web.assets_frontend"/>

            </head>

            <body class="ar-visitors-kiosk" t-att-lang="'ar' if visit.language == 'ar' else visit.language" t-att-dir="'rtl' if visit.language == 'ar' else 'ltr'">

                <main class="ar-kiosk-card">

                    <header><span class="ar-brand">AR</span><h1 t-out="labels['brand']"/><span class="ar-reference" t-out="visit.name"/></header>

                    <div t-if="error" class="ar-alert ar-alert-danger" t-out="error"/>

                    <div class="ar-person-summary">

                        <img t-if="visit.photo" t-att-src="'/ar-visitors/kiosk/%s/photo' % visit.kiosk_token" alt="Photo"/>

                        <div><strong><t t-out="visit.first_name"/> <t t-out="visit.last_name"/></strong><small><t t-out="labels['document']"/> ••••<t t-out="(visit.cin or '')[-4:]"/></small></div>

                    </div>



                    <section t-if="visit.state == 'identity_input'" class="ar-step">

                        <h2 t-out="labels['identity_title']"/>

                        <p t-if="visit.photo" t-out="labels['identity_intro']"/>

                        <form class="ar-details-form" t-att-action="'/ar-visitors/kiosk/%s/identity' % visit.kiosk_token" method="post">

                            <label t-out="labels['first_name']"/>

                            <input type="text" name="first_name" required="required" maxlength="100" t-att-value="visit.first_name or ''"/>

                            <label t-out="labels['last_name']"/>

                            <input type="text" name="last_name" required="required" maxlength="100" t-att-value="visit.last_name or ''"/>

                            <label t-out="labels['document']"/>

                            <input type="text" name="cin" required="required" maxlength="30" t-att-value="visit.cin or ''"/>

                            <label for="ar-visitor-company" t-out="labels['company']"/>
                            <input id="ar-visitor-company" type="text" name="visitor_company" maxlength="200" t-att-value="visit.visitor_company or ''"/>
                            <label for="ar-nationality" t-out="labels['nationality']"/>
                            <select id="ar-nationality" name="nationality_id">
                                <option value="">—</option>
                                <option t-foreach="countries" t-as="country" t-att-value="country.id"
                                    t-att-selected="country.id == visit.nationality_id.id" t-out="country.name"/>
                            </select>
                            <button class="ar-primary" type="submit" t-out="labels['continue']"/>

                        </form>

                    </section>



                    <section t-if="visit.state == 'identity_check'" class="ar-step">
                        <p t-out="labels['quiz_unavailable']"/>
                        <a class="ar-button ar-primary" t-att-href="'/ar-visitors/kiosk/%s' % visit.kiosk_token">
                            <t t-out="labels['retry']"/>
                        </a>
                    </section>






                    <section t-if="visit.state == 'quiz_pending'" class="ar-step ar-center">

                        <h2 t-out="labels['quiz_title']"/>

                        <p t-out="labels['quiz_intro']"/>

                        <button id="ar-open-quiz" type="button" class="ar-primary" t-att-data-quiz-url="'/ar-visitors/kiosk/%s/quiz' % visit.kiosk_token">

                            <t t-out="labels['open_quiz']"/>

                        </button>

                        <dialog id="ar-quiz-dialog" aria-labelledby="ar-quiz-title" t-att-data-status-url="'/ar-visitors/kiosk/%s/quiz-status' % visit.kiosk_token">

                            <header><h2 id="ar-quiz-title">Quiz</h2><button id="ar-close-quiz" type="button" aria-label="Fermer">×</button></header>

                            <iframe title="Quiz visiteur"/>

                        </dialog>

                    </section>



                    <section t-if="visit.state == 'host_pending'" class="ar-step">

                        <h2 t-out="labels['visit_title']"/>

                        <form class="ar-details-form" t-att-action="'/ar-visitors/kiosk/%s/details' % visit.kiosk_token" method="post">

                            <label t-out="labels['host']"/>

                            <select name="host_employee_id" required="required"><option value="">—</option><option t-foreach="employees" t-as="employee" t-att-value="employee.id" t-out="employee.name"/></select>

                            <label t-out="labels['purpose']"/><input type="text" name="purpose" maxlength="200"/>

                            <label t-out="labels['signature']"/>
                            <canvas id="ar-entry-signature" width="800" height="240" style="width:100%;height:160px;border:1px solid #cbd5e1;border-radius:12px;background:white;touch-action:none;" t-att-aria-label="labels['signature']"/>
                            <input type="hidden" name="entry_signature" id="ar-entry-signature-value"/>
                            <button type="button" id="ar-clear-signature" t-out="labels['clear_signature']"/>
                            <p id="ar-signature-error" hidden="hidden" t-out="labels['signature_required']"/>
                            <button class="ar-primary" type="submit" t-out="labels['save']"/>

                        </form>

                    </section>



                    <section t-if="visit.state == 'approval_pending'" class="ar-step ar-center">

                        <h2 t-out="labels['approval_title']"/><p t-out="labels['approval_text']"/>

                    </section>

                    <section t-if="visit.state == 'refused'" class="ar-step ar-center"><h2 t-out="labels['refused_title']"/><p t-out="labels['refused_text']"/></section>

                </main>

                <script src="/ar_visitors/static/src/js/entry_signature.js" defer="defer"/>
                <script src="/ar_visitors/static/src/js/kiosk_quiz.js?v=19.0.1.3.1" defer="defer"/>
            </body>

        </html>

    </template>



    <template id="kiosk_success" name="AR Visitors - Confirmation">

        <html><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>AR - Visitors</title><t t-call-assets="web.assets_frontend"/></head>

        <body class="ar-visitors-kiosk" t-att-lang="'ar' if visit.language == 'ar' else visit.language" t-att-dir="'rtl' if visit.language == 'ar' else 'ltr'"><main class="ar-kiosk-card ar-success"><div class="ar-success-icon">✓</div><h1 t-out="labels['success_title']"/><p t-if="visit.notification_state == 'sent'" t-out="labels['success_sent']"/><p t-else="" t-out="labels['success_pending']"/><strong t-out="visit.name"/></main></body></html>

    </template>

</odoo>

