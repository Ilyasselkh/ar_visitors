<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_expire_visitor_invitations" model="ir.cron">
        <field name="name">AR - Visitors : expirer les invitations</field>
        <field name="model_id" ref="model_ar_visitor_invitation"/>
        <field name="state">code</field>
        <field name="code">model._cron_expire_invitations()</field>
        <field name="interval_number">1</field><field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_send_visitor_notifications" model="ir.cron">
        <field name="name">AR - Visitors : notifier les contacts en arrière-plan</field>
        <field name="model_id" ref="model_ar_visitor_visit"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_visitor_notifications()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_cancel_expired_kiosk_visits" model="ir.cron">
        <field name="name">AR - Visitors : annuler les sessions expirées</field>
        <field name="model_id" ref="model_ar_visitor_visit"/>
        <field name="state">code</field>
        <field name="code">model._cron_cancel_expired_kiosk_visits()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>

