<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_ar_visitors" model="ir.module.category">
        <field name="name">AR - Visitors</field>
        <field name="description">Gestion des visiteurs et de l'intégration faciale</field>
        <field name="sequence">38</field>
    </record>

    <record id="privilege_ar_visitors_user" model="res.groups.privilege">
        <field name="name">AR - Visitors - Accueil</field>
        <field name="category_id" ref="module_category_ar_visitors"/>
        <field name="sequence">10</field>
    </record>
    <record id="group_ar_visitors_user" model="res.groups">
        <field name="name">Agent d'accueil</field>
        <field name="privilege_id" ref="privilege_ar_visitors_user"/>
    </record>

    <record id="privilege_ar_visitors_manager" model="res.groups.privilege">
        <field name="name">AR - Visitors - Responsable</field>
        <field name="category_id" ref="module_category_ar_visitors"/>
        <field name="sequence">20</field>
    </record>
    <record id="group_ar_visitors_manager" model="res.groups">
        <field name="name">Responsable</field>
        <field name="privilege_id" ref="privilege_ar_visitors_manager"/>
        <field name="implied_ids" eval="[(4, ref('group_ar_visitors_user'))]"/>
    </record>

    <record id="privilege_ar_visitors_admin" model="res.groups.privilege">
        <field name="name">AR - Visitors - Administration</field>
        <field name="category_id" ref="module_category_ar_visitors"/>
        <field name="sequence">30</field>
    </record>
    <record id="group_ar_visitors_admin" model="res.groups">
        <field name="name">Administrateur</field>
        <field name="privilege_id" ref="privilege_ar_visitors_admin"/>
        <field name="implied_ids" eval="[(4, ref('group_ar_visitors_manager'))]"/>
    </record>

    <record id="privilege_ar_visitors_api_admin" model="res.groups.privilege">
        <field name="name">AR - Visitors - API faciale</field>
        <field name="category_id" ref="module_category_ar_visitors"/>
        <field name="sequence">40</field>
    </record>
    <record id="group_ar_visitors_api_admin" model="res.groups">
        <field name="name">Administrateur API</field>
        <field name="privilege_id" ref="privilege_ar_visitors_api_admin"/>
        <field name="implied_ids" eval="[(4, ref('group_ar_visitors_admin'))]"/>
    </record>

    <record id="rule_ar_visitor_person_company" model="ir.rule">
        <field name="name">Personnes visiteurs multi-sociétés</field>
        <field name="model_id" ref="model_ar_visitor_person"/>
        <field name="domain_force">['|', ('visit_ids.company_id', 'in', company_ids), ('visit_ids', '=', False)]</field>
        <field name="groups" eval="[(4, ref('group_ar_visitors_user'))]"/>
    </record>
    <record id="rule_ar_visitor_visit_company" model="ir.rule">
        <field name="name">Visites multi-sociétés</field>
        <field name="model_id" ref="model_ar_visitor_visit"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_ar_visitors_user'))]"/>
    </record>
</odoo>

